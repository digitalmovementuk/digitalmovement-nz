# Where enquiries are delivered. A URL that accepts a JSON POST — a
# GoHighLevel inbound webhook, or any form backend. NOT a secret: this is a
# static site, so anything here ships to the browser. Never put a
# GoHighLevel private token in it.
# Without this set, the forms show a visible failure and the direct email
# instead of a false "thank you".
VITE_LEAD_ENDPOINT=

# GA4 measurement ID, e.g. G-XXXXXXXXXX. Omit to ship no analytics at all.
VITE_GA4_ID=
