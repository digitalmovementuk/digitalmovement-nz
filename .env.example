# Where enquiries are delivered.
#
# NOTHING IN THIS FILE IS A SECRET. This is a static site, so every value
# below is compiled into the JavaScript that ships to the browser and can be
# read by anyone. Never put a GoHighLevel private token, an SMTP password, or
# any other credential here.

# Comma-separated Web3Forms access keys. Each key delivers to the single inbox
# it was registered to — Web3Forms' cc field is PRO-only, so reaching two
# people takes two keys, not one key with two addresses. Enquiries must reach
# both martey@digitalmovement.com.au and alex@digitalmovement.uk.
# Get a key at https://app.web3forms.com/ (one signup per destination inbox).
VITE_WEB3FORMS_KEYS=

# Optional extra destination: any URL that accepts a JSON POST, e.g. a
# GoHighLevel inbound webhook. Leave blank unless one exists. When set, it
# receives a copy alongside the Web3Forms keys.
VITE_LEAD_ENDPOINT=

# With neither of the above set, the forms show a visible failure and the
# direct email address instead of a false "thank you".

# GA4 measurement ID. Omit to ship no analytics at all.
# Live property: "Digital Movement NZ" (547960905), in the "Digital Movement
# New Zealand" account (403043879), owned by alex@digitalmovement.uk.
VITE_GA4_ID=G-XG6LEK04KT
