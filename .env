# Primary lead destination — Digital Movement's own PHP handler.
# Subdomain ROOT, no /send.php. Requires the origin on its allowlist and a
# `consent` field in the payload. Delivers NZ enquiries to BOTH
# martey@digitalmovement.com.au and alex@digitalmovement.uk.
VITE_DM_LEAD_ENDPOINT=https://leads.digitalmovement.uk/

# Optional extras, unused for now. Web3Forms needs a per-inbox signup; the
# generic webhook is reserved for a future CRM.
VITE_WEB3FORMS_KEYS=
VITE_LEAD_ENDPOINT=

# GA4 — property "Digital Movement NZ" (547960905).
VITE_GA4_ID=G-XG6LEK04KT
